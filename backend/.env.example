# SQLite (zero-setup local dev, default if unset):
# DATABASE_URL=sqlite+aiosqlite:///./hospital.db
#
# PostgreSQL (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://hospital:hospital@localhost:5432/hospital_finance

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false

# Set to true ONLY on a demo/pitch deployment: wipes and reseeds the ENTIRE
# database with demo data on every app startup, and enables the public,
# no-credentials POST /api/auth/demo-login endpoint that does the same on
# demand. This app has no tenant isolation, so demo mode wipes everything —
# never enable this on a deployment that holds real hospital data.
DEMO_MODE=false
