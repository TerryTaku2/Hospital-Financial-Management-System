# SQLite (zero-setup local dev, default if unset):
# DATABASE_URL=sqlite+aiosqlite:///./hospital.db
#
# PostgreSQL (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://hospital:hospital@localhost:5432/hospital_finance

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false
